+      sha256: createHash("sha256")
+        .update(JSON.stringify(content))
+        .digest("hex"),
+    };
+    const path = this.path(run.id);
+    writeFileSync(path + ".tmp", JSON.stringify(bundle, null, 2));
+    renameSync(path + ".tmp", path);
+  }
+}

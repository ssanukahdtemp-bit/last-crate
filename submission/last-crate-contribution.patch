+    r.answer !== "confirmed" ||
+    r.breadOnly !== "yes" ||
+    r.release !== "yes" ||
+    !Number.isInteger(r.quantity) ||
+    r.quantity < 1 ||
+    r.quantity > 500 ||
+    !Number.isFinite(minutes(r.ready)) ||
+    !Number.isFinite(minutes(r.cutoff)) ||
+    minutes(r.ready) >= minutes(r.cutoff)
